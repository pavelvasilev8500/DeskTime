<Window x:Class="DeskTime.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeskTime.Views"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        Height="600" 
        Width="400">
    <Grid>
        <ContentControl prism:RegionManager.RegionName="ContentRegion" />
        <Border Background="#909090"
                CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>

                
                <Border Grid.Row="0"
                        CornerRadius="20,20,0,0" 
                        Background="White" 
                        Height="30" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Top" 
                        Opacity="0.465"
                        PreviewMouseLeftButtonDown="Move">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" 
                                  Direction="270" 
                                  Opacity="0.625" 
                                  BlurRadius="6"/>
                    </Border.Effect>
                </Border>
                
                <TextBlock Grid.Row="0" 
                           Text="Settings"
                           Foreground="Black"
                           FontWeight="Bold"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           PreviewMouseLeftButtonDown="Move"/>

                <Button Grid.Row="0"
                        Content="Close"
                        Click="Close"
                        Height="30"
                        Width="30"
                        HorizontalAlignment="Right"/>

                <StackPanel Grid.Row="1"
                            Orientation="Vertical">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Color"/>
                            <StackPanel Orientation="Vertical">
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="R"/>
                                    <TextBox Text="{Binding Color}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="G"/>
                                    <TextBox Text="{Binding Color}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="B"/>
                                    <TextBox Text="{Binding Color}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Hex"/>
                                    <TextBox Text="{Binding Color}"/>
                                </StackPanel>
                                <Button Content="Apply"
                                Command="{Binding ApplyCommand}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="City"/>
                            <TextBox Text="{Binding Color}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Time font size"/>
                            <TextBox Text="{Binding Color}"/>
                        </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Weather font size"/>
                        <TextBox Text="{Binding Color}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="2"
                        CornerRadius="0,0,20,20" 
                        Background="White" 
                        Height="20" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Bottom" 
                        Opacity="0.465">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" 
                                  Direction="-270" 
                                  Opacity="0.625" 
                                  BlurRadius="6"/>
                    </Border.Effect>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
