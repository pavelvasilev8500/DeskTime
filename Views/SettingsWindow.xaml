<Window x:Class="DeskTime.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeskTime.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:materialDesignColors="clr-namespace:MaterialDesignColors;assembly=MaterialDesignColors"          
        xmlns:materialDesignConverters="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        Height="600" 
        Width="400">
    <Grid>
        <Border Background="White"
                CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>

                
                <Border Grid.Row="0"
                        CornerRadius="20,20,0,0" 
                        Background="White" 
                        Height="30" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Top" 
                        Opacity="0.465"
                        PreviewMouseLeftButtonDown="Move">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" 
                                  Direction="270" 
                                  Opacity="0.625" 
                                  BlurRadius="6"/>
                    </Border.Effect>
                </Border>

                <TextBlock Grid.Row="0" 
                           Text="Settings"
                           Foreground="Black"
                           FontWeight="Bold"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           PreviewMouseLeftButtonDown="Move"/>

                <materialDesign:Card
                    Grid.Row="1"
  Width="200"
 >
                    <Grid
   >
                        <Grid.RowDefinitions>
                            <RowDefinition
        Height="140" />
                            <RowDefinition
        Height="*" />
                            <RowDefinition
        Height="Auto" />
                        </Grid.RowDefinitions>
                        <Image
      Height="140"
      Source="Resources/Chartridge046_small.jpg"
      Stretch="UniformToFill" />
                        <Button
      Grid.Row="0"
      Margin="0,0,16,-20"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      Style="{StaticResource MaterialDesignFloatingActionMiniButton}">
                            <materialDesign:PackIcon
        Kind="Bike" />
                        </Button>
                        <StackPanel
      Grid.Row="1"
      Margin="8,24,8,0">
                            <TextBlock
        FontWeight="Bold">
      Cycling
                            </TextBlock>
                            <TextBlock
        VerticalAlignment="Center"
        Text="A great way to keep fit and forget about the constant grind of IT."
        TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
      Grid.Row="2"
      Margin="8"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
                            <Button
        Width="30"
        Padding="2,0,2,0"
        materialDesign:RippleAssist.IsCentered="True"
        Style="{StaticResource MaterialDesignToolButton}">
                                <materialDesign:PackIcon
          Kind="ShareVariant" />
                            </Button>
                            <Button
        Width="30"
        Padding="2,0,2,0"
        materialDesign:RippleAssist.IsCentered="True"
        Style="{StaticResource MaterialDesignToolButton}">
                                <materialDesign:PackIcon
          Kind="Heart" />
                            </Button>
                            <materialDesign:PopupBox
        Padding="2,0,2,0"
        Style="{StaticResource MaterialDesignToolPopupBox}">
                                <StackPanel>
                                    <Button
            Content="More" />
                                    <Button
            Content="Options" />
                                </StackPanel>
                            </materialDesign:PopupBox>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <Border Grid.Row="2"
                        CornerRadius="0,0,20,20" 
                        Background="White" 
                        Height="20" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Bottom" 
                        Opacity="0.465">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="4" 
                                  Direction="-270" 
                                  Opacity="0.625" 
                                  BlurRadius="6"/>
                    </Border.Effect>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
